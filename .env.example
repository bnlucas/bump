# Copy to .env.local and fill in.
# .env.local is gitignored; .env.example is committed as documentation.

# --- Simbee (server-side; never expose to the browser) ---
SIMBEE_API_KEY=simbee_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default production host.
# SIMBEE_HOST=https://api.simbee.io
# Simbee config keys (resolved to UUIDs at runtime via
# /api/v1/config/{signal_types,consent_layers}). Override only if you
# named these differently in your tenant config; otherwise the
# defaults below are used.
# SIMBEE_CONSENT_LAYER_KEY=dating
# SIMBEE_SIGNAL_KEY_INTEREST=interest
# SIMBEE_SIGNAL_KEY_PASS=pass
# SIMBEE_SIGNAL_KEY_LIKE=like

# ShrouDB namespace where post bodies are stored. Created lazily on
# first write. Override only if you've already provisioned a different
# namespace name.
# SHROUDB_POSTS_NAMESPACE=posts

# --- ShrouDB (server-side) ---
SHROUDB_MOAT=https://moat.example.com
SHROUDB_TOKEN=

# --- Herald (server-side; the browser only ever receives a minted client token) ---
HERALD_WS_URL=wss://herald.example.com/ws
HERALD_HTTP_URL=https://herald.example.com
HERALD_TENANT_KEY=tenant_key_xxxxxxxxxxxx
HERALD_TENANT_SECRET=tenant_secret_xxxxxxxxxxxx
